# Local SQLite storage defaults to backend/klarity.db.
# For Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Set false for an empty workspace instead of sample data.
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local test account: disable before deployment.
ENABLE_TEST_ACCOUNT=true
COOKIE_SECURE=false

# ── Email OTP Configuration ──────────────────────────────────────────
# Gmail SMTP settings for sending OTP verification codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=goklarity@gmail.com
SMTP_PASSWORD=
OTP_FROM_NAME=Klarity
OTP_EXPIRY_MINUTES=5
